rules_version = '2';

// AR Storefront — asset storage.
//
// Paths are split by asset kind rather than lumped under one wildcard, because
// the size ceiling that makes sense for a scanned 3D model (tens of MB) would be
// reckless for a logo. Splitting the paths lets each kind carry its own limit.
//
// As with Firestore, `shops/{shopId}` uses the owner's uid as the folder name,
// so ownership is a string compare.

service firebase.storage {
  match /b/{bucket}/o {

    function owns(shopId) {
      return request.auth != null && request.auth.uid == shopId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Product demos: mp4/webm/mov. Keep the list tight — arbitrary video/*
    // would let owners upload formats the storefront cannot play.
    function isProductVideo() {
      return request.resource.contentType == 'video/mp4'
             || request.resource.contentType == 'video/webm'
             || request.resource.contentType == 'video/quicktime';
    }

    // .usdz and .glb are frequently handed to the browser with no type at all,
    // so octet-stream has to be tolerated here. The upload code sets an explicit
    // contentType; this is the safety net for when it doesn't stick.
    function isModel() {
      return request.resource.contentType.matches('model/.*')
             || request.resource.contentType == 'application/octet-stream';
    }

    match /shops/{shopId}/branding/{file} {
      allow read: if true;
      allow create, update: if owns(shopId)
                            && isImage()
                            && request.resource.size < 4 * 1024 * 1024;
      allow delete: if owns(shopId);
    }

    // Still photos and short product videos share this folder so existing
    // photoUrls/photoPaths keep working. Images stay under 8MB; videos 50MB.
    match /shops/{shopId}/products/{productId}/photos/{file} {
      allow read: if true;
      allow create, update: if owns(shopId)
                            && (
                              (isImage() && request.resource.size < 8 * 1024 * 1024)
                              || (isProductVideo() && request.resource.size < 50 * 1024 * 1024)
                            );
      allow delete: if owns(shopId);
    }

    match /shops/{shopId}/products/{productId}/models/{file} {
      allow read: if true;
      allow create, update: if owns(shopId)
                            && isModel()
                            && request.resource.size < 50 * 1024 * 1024;
      allow delete: if owns(shopId);
    }

    // Husn-e-Tarteeb product photos. Single-owner site, so write access is
    // one account rather than a per-shop uid — see firestore.rules for why
    // this matches on email. Images only, and smaller than the arshop limit
    // because these are catalogue stills, never scans or video.
    function isHusnAdmin() {
      return request.auth != null
             && request.auth.token.email == 'hibaabbas1306@gmail.com';
    }

    // Photos are resized in the browser before upload so 8MB is generous;
    // videos are short product clips shot on a phone, hence the wider ceiling.
    match /husnetarteeb/products/{productId}/{file} {
      allow read: if true;
      allow create, update: if isHusnAdmin()
                            && (
                              (isImage() && request.resource.size < 8 * 1024 * 1024)
                              || (isProductVideo() && request.resource.size < 50 * 1024 * 1024)
                            );
      allow delete: if isHusnAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
