{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }], "destination": "/landing" },
    { "source": "/", "has": [{ "type": "host", "value": "localhost(:\\d+)?" }], "destination": "/landing" },
    { "source": "/", "destination": "/shop" },
    { "source": "/s/:slug", "destination": "/shop" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
